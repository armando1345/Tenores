{
  "name": "tenores",
  "account_id": "6e09b3b147d9e2a7234b301a21903494",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "PASSWORDS", "class_name": "PasswordHasher" }] },
  "migrations": [{ "tag": "v1-passwords", "new_sqlite_classes": ["PasswordHasher"] }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "tenores", "database_id": "6a4ae822-7c3b-4e82-bb99-bd3d0ea333b8", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "RECORDINGS", "bucket_name": "tenores-grabaciones" }],
  "vars": {}
}
